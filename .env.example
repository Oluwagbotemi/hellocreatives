# Copy these into Vercel → Project → Settings → Environment Variables
# (and into a local .env.local file for development). See docs/events-setup.md.

# --- Sanity (events content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret. "Editor" token from sanity.io/manage → API → Tokens.
SANITY_API_TOKEN=

# --- Resend (confirmation emails) ---
# Secret. From resend.com → API Keys.
RESEND_API_KEY=
# Must use a domain you've verified in Resend.
RESEND_FROM_EMAIL=Hello Creatives <events@hellocreatives.io>

# --- Site addresses ---
NEXT_PUBLIC_DOMAIN=hellocreatives.io
NEXT_PUBLIC_EVENTS_URL=https://events.hellocreatives.io

# --- Existing (EmailJS: newsletter + "Write for us" forms) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SUBSCRIBE_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PITCH_TEMPLATE_ID=
